{
  "name": "@burnt-labs/xion-types",
  "version": "0.0.1",
  "author": "burnt-labs <devops@burnt.com>",
  "description": "xion-types",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "homepage": "https://github.com/burnt-labs/xion-types",
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/burnt-labs/xion-types"
  },
  "bugs": {
    "url": "https://github.com/burnt-labs/xion-types/issues"
  },
  "scripts": {
    "copy": "copyfiles -f ./LICENSE README.md package.json dist && copyfiles -u 1 'types/contracts/*/schema/**/*.json' dist",
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsc && tsc -p tsconfig.esm.json && pnpm run copy",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint . --fix"
  },
  "devDependencies": {
    "@cosmwasm/ts-codegen": "1.12.1",
    "@types/node": "^22.14.1",
    "copyfiles": "^2.4.1",
    "rimraf": "^6.0.1",
    "ts-proto": "2.11.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.8.0",
    "@improbable-eng/grpc-web": "^0.15.0",
    "browser-headers": "^0.4.1"
  },
  "peerDependencies": {
    "@cosmjs/proto-signing": ">=0.32.3",
    "@cosmjs/stargate": ">=0.32.3",
    "@cosmjs/tendermint-rpc": ">=0.32.3"
  },
  "keywords": [],
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "tmp": "0.2.7",
      "js-yaml@<3.15.0": "3.15.0",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=3.0.0 <5.0.7": "5.0.7",
      "js-yaml@>=3.0.0 <3.15.0": "3.15.0",
      "brace-expansion@<1.1.17": "1.1.17",
      "brace-expansion@>=2.0.0 <2.1.3": "2.1.3",
      "brace-expansion@>=4.0.0 <5.0.8": "5.0.8",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@<1.1.18": "1.1.18",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1"
    }
  }
}
